# La clave real va en .env.local, nunca en este archivo.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
# Modelo de texto para generar guías de entrevista, repreguntas y síntesis de procesos.
OPENAI_TEXT_MODEL=gpt-5.1
# Transcripción en servidor del modo de entrevista asíncrona.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

